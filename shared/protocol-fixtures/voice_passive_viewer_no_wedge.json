{
  "name": "voice_passive_viewer_no_wedge",
  "description": "Passive viewer of a Qwen voice session started on another device: mirrored events render transcripts, lifecycle events finalize the conversation; the reducer ends idle with voice inactive. The voice controller expectations (own state stays off; remoteActive true then false) are in expected.controller and are checked by the voice-controller tests, not by the reducer runner.",
  "source": "synthetic",
  "session": {
    "kind": "orchestrator",
    "provider": null,
    "local_id": "O1",
    "sdk_id": "O1"
  },
  "initial_history": null,
  "events": [
    {
      "type": "session_started",
      "session_id": "O1",
      "voice": true,
      "voice_initiator": false,
      "model_info": {
        "model": "gpt-audio",
        "provider": "openai",
        "max_tokens": 4096,
        "supports_audio": true,
        "model_info": null
      },
      "voice_provider": "qwen",
      "voice_model": "qwen3.5-omni-plus-realtime",
      "voice_name": "Aiden",
      "voice_transcription_language": "en",
      "voice_recording_enabled": false
    },
    {
      "type": "voice_owner_active",
      "active": true,
      "owner_local_id": "O1"
    },
    {
      "type": "voice_event",
      "event": {
        "type": "input_audio_buffer.speech_started"
      }
    },
    {
      "type": "voice_event",
      "event": {
        "type": "voice_vad_state",
        "state": "listening",
        "duration_ms": 1000,
        "silero_prob": 0.91
      }
    },
    {
      "type": "voice_event",
      "event": {
        "type": "conversation.item.input_audio_transcription.completed",
        "item_id": "i1",
        "content_index": 0,
        "transcript": "Hello"
      }
    },
    {
      "type": "voice_event",
      "event": {
        "type": "response.created",
        "response": {
          "id": "r1"
        }
      }
    },
    {
      "type": "voice_event",
      "event": {
        "type": "response.audio_transcript.delta",
        "delta": "Hi"
      }
    },
    {
      "type": "voice_ending",
      "reason": "user_stop",
      "session_id": "O1"
    },
    {
      "type": "voice_ended",
      "reason": "user_stop",
      "session_id": "O1"
    },
    {
      "type": "voice_stopped"
    },
    {
      "type": "voice_owner_active",
      "active": false,
      "owner_local_id": "O1"
    }
  ],
  "expected": {
    "entries": [
      {
        "kind": "user",
        "text": "Hello",
        "origin": "voice",
        "state": "sent"
      },
      {
        "kind": "assistant",
        "blocks": [
          {
            "type": "text",
            "text": "Hi",
            "streaming": false
          }
        ]
      }
    ],
    "state": {
      "voice_active": false,
      "status": "idle",
      "in_turn": false
    },
    "controller": {
      "voice_state": "off",
      "remote_active": false,
      "input_enabled": true
    }
  }
}

# Vector search index (regenerable from source files)
index/

# Python
__pycache__/
*.pyc

# Virtual environment (no trailing slash — .venv is a symlink on server)
.venv

# Environment
.env

# Manager local config (only the runtime copy at the repo root; the
# install/ template is checked in).
/.manager.json
/assistant_config.json

# Frontend build output (frontend/ has its own .gitignore too)
frontend/dist/
frontend/node_modules/

# Local logs
logs/
remote_console.log

# Context is an independent repo, ignored here
context/

# Claude Code SDK config (symlink to context/)
.claude_config/

# Per-user CLI runtime dirs — auto-generated by each agent on first run.
# Contents are machine-local (settings.local.json, lock files, symlinks).
# Cross-machine sync of these is handled separately via context/.
.claude/
.qwen/
.gemini/

# Claude Code runtime artifacts (created if CLAUDE_CONFIG_DIR is not set)
.claude.json
.claude.json.backup.*
debug/
!android/**/src/debug/
projects/
todos/
plugins/

# Secrets, credentials, and certificates
secrets/
certs/

# Temporary files
.index-temp/
*.egg-info/
.ruff_cache/
.mypy_cache/

# Old Android app, kept under _old/ since the 2026-10 cutover
_old/android/.gradle/
_old/android/app/build/
_old/android/app/.cxx/
_old/android/build/
_old/android/local.properties
_old/android/**/*.apk
_old/android/**/*.aab

# Android Device companion app
android-device/.gradle/
android-device/app/build/
android-device/build/
android-device/local.properties
android-device/**/*.apk
android-device/**/*.aab
sync/config.env
docs/frontend-refactor/audit/screenshots/

# Android apps (android/, own .gitignore): signing paths/passwords, never committed (spec 14 §1.8)
android/keystore.properties

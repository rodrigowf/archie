<?xml version="1.0" encoding="utf-8"?>
<!-- E-6: LAN cleartext stays allowed (ws://192.168.0.200:80), as the old app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

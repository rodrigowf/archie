# Jetson → Desktop sync config (install on Jetson as config.env)
LOCAL_DIR=/home/rodrigo/assistant/context
REMOTE_HOST=192.168.0.230
# Optional: every address the remote answers on, best first — e.g. its LAN IP at
# home and a VPN/tailnet IP anywhere else. The first that answers is used, and
# the list is re-probed whenever it stops answering, so coming home switches
# back on its own. Unset = just REMOTE_HOST.
# REMOTE_HOSTS="192.168.0.230 100.x.y.z"
REMOTE_USER=rodrigo
REMOTE_DIR=/home/rodrigo/assistant/context
SSH_KEY=/home/rodrigo/.ssh/id_ed25519
DEBOUNCE_SECONDS=2
RETRY_INTERVAL=30

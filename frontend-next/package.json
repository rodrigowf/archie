{
  "name": "frontend-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Archie web app (main + Safari 12 compat builds). See docs/frontend-refactor/spec/13-web-architecture.md",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite -c vite.config.main.ts",
    "dev:compat": "vite -c vite.config.compat.ts",
    "preview": "vite preview -c vite.config.main.ts",
    "preview:compat": "vite preview -c vite.config.compat.ts",
    "mock": "node mock-server/server.mjs",
    "build": "npm run typecheck && npm run gate:tokens && npm run build:main && npm run build:compat && npm run gate:compat && npm run gate:budgets",
    "build:main": "vite build -c vite.config.main.ts",
    "build:compat": "vite build -c vite.config.compat.ts",
    "build:preview": "FN_BASE=/next/ FN_OUT=dist-preview/main vite build -c vite.config.main.ts && FN_BASE=/next-compat/ FN_OUT=dist-preview/compat vite build -c vite.config.compat.ts && node scripts/scan-compat-bundle.mjs dist-preview/compat",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings=0 .",
    "lint:css": "stylelint --allow-empty-input \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gate:compat": "node scripts/scan-compat-bundle.mjs dist-compat",
    "gate:budgets": "node scripts/check-budgets.mjs",
    "gate:tokens": "npm --prefix ../design/tokens run check && node scripts/check-token-vars.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "verify": "npm run lint && npm run lint:css && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@juggle/resize-observer": "3.4.0",
    "diff": "9.0.0",
    "focus-visible": "5.2.1",
    "hast-util-to-jsx-runtime": "2.3.6",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tabbable": "6.5.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint-community/regexpp": "4.12.2",
    "@material-symbols/svg-400": "0.47.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "axe-core": "4.13.0",
    "core-js": "3.50.0",
    "eslint": "9.39.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-es-x": "9.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.28",
    "postcss-preset-env": "11.6.0",
    "source-map-js": "1.2.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "overrides": {
    "highlight.js": "$highlight.js"
  }
}

# context-sync configuration
#
# This file configures the `context-sync` systemd user service, which keeps the
# context/ folder in sync between two machines (e.g. a laptop and a server)
# via inotifywait + rsync over SSH.  Skip this file entirely if you only run
# the assistant on a single machine.
#
# Copy this file to infra/sync/config.env and fill in your values.
# config.env is gitignored — never commit it (contains paths/keys).

# Local directory to sync (absolute path, no trailing slash)
LOCAL_DIR=/home/youruser/assistant/context

# Remote machine
REMOTE_HOST=192.168.0.200
REMOTE_USER=youruser

# Optional: every address the remote answers on, best first — typically its LAN
# IP plus a VPN/tailnet IP for when the machine is away. The first that answers
# is used, and the list is re-probed whenever it stops answering, so coming back
# to the LAN switches over on its own. Unset = just REMOTE_HOST.
# Only the side that can open the connection needs it: a reconcile lists the
# remote and then rsyncs both ways, so one working direction converges both
# machines. While a fallback address is in use the reconcile interval drops to
# RECONCILE_SECONDS_FALLBACK, because the other side probably cannot reach us.
# REMOTE_HOSTS="192.168.0.200 100.x.y.z"
# RECONCILE_SECONDS_FALLBACK=60

# Remote directory to sync to (absolute path, no trailing slash)
REMOTE_DIR=/home/youruser/assistant/context

# SSH private key for passwordless auth (must be set up in advance)
SSH_KEY=/home/youruser/.ssh/id_ed25519

# Seconds to wait after last file change before triggering rsync (debounce).
# Increase if you see excessive sync events during long streaming responses.
DEBOUNCE_SECONDS=2

# Seconds to wait before retrying when remote is offline
RETRY_INTERVAL=30

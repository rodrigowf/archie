# Agent CLI versions Archie's harnesses are verified against.
#
# Single source of truth for the installers and the doctor:
#   - install/{linux,apple}/install.sh and install-with-agent.sh source this file
#   - install/windows/install.ps1 and install-with-agent.ps1 parse it
#   - install/doctor.sh compares the installed CLIs against it
#
# Format: plain KEY=VALUE lines (no quotes, no spaces, no inline comments) so
# both bash and PowerShell can read it.  When bumping a pin, follow the
# harness doc's "Upgrading the CLI" checklist (docs/harnesses/<harness>.md).
# backend/manager/qwen/adapter.py QWEN_CLI_VERSION must match QWEN_CLI_VERSION
# here (doctor.sh warns when they differ).  The claude-agent-sdk pin (which
# bundles the Claude Code CLI) lives in backend/requirements-claude.txt.

# @qwen-code/qwen-code (Node program; this version needs Node 22+)
QWEN_CLI_VERSION=0.25.0
# @google/gemini-cli (Node program)
GEMINI_CLI_VERSION=0.63.0
# @openai/codex (native binary; also published as static builds on GitHub
# releases, tag rust-v<version>, used when the host has no usable Node)
CODEX_CLI_VERSION=0.161.0
# Minimum Node.js major for the web toolchain (apps/web engines >=22.12) and Qwen.
NODE_MIN_MAJOR=22
